# Enosis demo environment variables (all optional)

# OCR languages for tesseract.js. Latin + Simplified Chinese + Traditional
# Chinese by default. Format: "+" separated codes.
ENOSIS_OCR_LANGS="eng+chi_sim+chi_tra"

# DeepSeek API (reserved for future translation/enrichment features)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"
