# Enosis demo environment variables (all optional)

# OpenRouter API key for vision extraction, classification, and translation.
# Get a key at https://openrouter.ai/keys. Free keys work with the default
# free vision model; credits are optional (paid models are faster/more reliable).
OPENROUTER_API_KEY=""

# Vision model used for image documents. Defaults to a free model
# (google/gemma-4-26b-a4b-it:free, verified fast and accurate on the demo
# fixture). Pin a paid model only if you have credits and want maximum
# reliability, e.g.:
# ENOSIS_VISION_MODEL="google/gemini-2.5-flash"

# Free fallback used when the primary model stalls or returns junk. It is
# slow-but-working (measured 19-50s); the vision budget (55s) gives it room.
# ENOSIS_VISION_FALLBACK_MODEL="nvidia/nemotron-nano-12b-v2-vl:free"

# Translation model for zh-Hant-HK / zh-Hans-CN / en translation.
# Swap to the heavier model if accuracy matters more than latency:
# nvidia/nemotron-3-ultra-550b-a55b:free
ENOSIS_TRANSLATION_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# DeepSeek API (reserved for future features)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"
