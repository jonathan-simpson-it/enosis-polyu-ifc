# Enosis demo environment variables (all optional)

# OCR languages for tesseract.js. Latin + Indonesian + Simplified + Traditional
# Chinese by default. Format: "+" separated codes.
ENOSIS_OCR_LANGS="eng+ind+chi_sim+chi_tra"

# OpenRouter API key for vision fallback and translation.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Vision model used when tesseract OCR cannot read a document
# (routed automatically when post-NER confidence is low).
ENOSIS_VISION_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# Translation model for zh-Hant-HK / zh-Hans-CN / en translation.
# Swap to the heavier model if accuracy matters more than latency:
# nvidia/nemotron-3-ultra-550b-a55b:free
ENOSIS_TRANSLATION_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# DeepSeek API (reserved for future features)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"
