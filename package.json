{
  "name": "enosis",
  "version": "0.2.0",
  "private": true,
  "description": "Enosis: Next.js data ingestion engine for GBA trade documents",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npx playwright test --headed",
    "test:e2e:headless": "npx playwright test",
    "trading:setup": "python3.12 -m venv ml/.venv && ml/.venv/bin/pip install -r ml/requirements.txt",
    "trading:ingest": "ml/.venv/bin/python ml/ingest.py",
    "trading:vision": "ml/.venv/bin/python ml/vision.py --with-vision",
    "trading:train": "ml/.venv/bin/python ml/weak_labels.py",
    "trading:regression": "ml/.venv/bin/python ml/regression.py",
    "trading:ml": "cd ml && ./.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000",
    "test:trading": "ml/.venv/bin/python -m pytest ml/tests -q",
    "test:trading:e2e": "playwright test --config playwright.trading.config.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@phosphor-icons/react": "^2.1.10",
    "katex": "^0.19.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.3.5",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
